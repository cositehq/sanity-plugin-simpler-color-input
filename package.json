{
  "name": "sanity-plugin-simpler-color-input",
  "version": "4.0.0",
  "description": "A simpler color input",
  "keywords": [
    "sanity",
    "sanity-plugin",
    "color-input"
  ],
  "homepage": "https://github.com/cositehq/sanity-plugin-simpler-color-input#readme",
  "bugs": {
    "url": "https://github.com/cositehq/sanity-plugin-simpler-color-input/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/cositehq/sanity-plugin-simpler-color-input.git"
  },
  "license": "MIT",
  "author": "Alyssa Melendez <alyssa@cositehq.com>",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./lib/index.mjs",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./lib/index.js",
  "module": "./lib/index.esm.js",
  "types": "./lib/index.d.ts",
  "files": [
    "lib",
    "sanity.json",
    "src",
    "v2-incompatible.js"
  ],
  "scripts": {
    "build": "plugin-kit verify-package --silent && pkg-utils build --strict --check --clean",
    "compile": "tsc --noEmit",
    "format": "prettier --write --cache --ignore-unknown .",
    "link-watch": "plugin-kit link-watch",
    "lint": "eslint .",
    "prepare": "husky install",
    "prepublishOnly": "npm run build",
    "watch": "pkg-utils watch --strict"
  },
  "browserslist": "extends @sanity/browserslist-config",
  "prettier": "@sanity/prettier-config",
  "overrides": {
    "conventional-changelog-conventionalcommits": ">= 9.3.1"
  },
  "dependencies": {
    "@sanity/icons": "^3.8.0",
    "@sanity/incompatible-plugin": "^1.0.5",
    "@sanity/ui": "^3.5.4",
    "@uiw/react-color": "^2.10.3",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@sanity/pkg-utils": "^6.13.5",
    "@sanity/plugin-kit": "^4.0.20",
    "@sanity/prettier-config": "1.0.6",
    "@sanity/semantic-release-preset": "^5.0.0",
    "@types/react": "^19.2.18",
    "@types/react-color": "^2.17.12",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-config-sanity": "^7.1.4",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "husky": "^8.0.3",
    "lint-staged": "^13.3.0",
    "npm-run-all2": "^5.0.2",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sanity": "^5.31.2",
    "semantic-release": "^24.2.9",
    "styled-components": "^6.5.3",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "react": "^19.2.2",
    "react-dom": "^19.2.2",
    "sanity": "^5.0.0",
    "styled-components": "^6.1.15"
  },
  "engines": {
    "node": ">=18"
  },
  "sanityPlugin": {
    "verifyPackage": {
      "sanityV2Json": false,
      "v2PluginMigrated": false
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "sanityExchangeUrl": "https://www.sanity.io/plugins/sanity-plugin-simpler-color-input"
}
